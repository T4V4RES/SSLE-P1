[Unit]
Description=Correlacao SSLE entre agentes por site
After=wazuh-manager.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/ssle-correlate.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/ssle
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
